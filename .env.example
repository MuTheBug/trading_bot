# Binance USDT-M Futures Trading Bot - environment variables
# Copy to .env and fill in your credentials. The installer does this for you.

# --- Binance API (create at https://www.binance.com/en/my/settings/api-management) ---
# Required scopes: Enable Futures. DISABLE withdrawals. IP-whitelist strongly recommended.
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Use Binance Futures testnet (https://testnet.binancefuture.com) if true
BINANCE_TESTNET=false

# --- Telegram bot (create via @BotFather, get chat id via @userinfobot) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# --- AI brain: MiniMax Token Plan (Anthropic-compatible API) ---
# Get your key at https://platform.minimax.io/user-center/basic-information/interface-key
# The bot uses the `anthropic` Python SDK pointed at MiniMax's base URL.
ANTHROPIC_API_KEY=your_minimax_key_here
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic

# --- Default run mode: sim | live ---
RUN_MODE=sim
